page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f6f8;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page {
  min-height: 100vh;
  background: #f5f6f8;
}

.banner {
  width: 100%;
  height: 420rpx;
  display: block;
}

.content {
  padding: 40rpx 36rpx 60rpx 36rpx;
}

.name {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #1a1a1a;
  letter-spacing: 2rpx;
}

.tagline {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #999999;
  line-height: 36rpx;
}

.divider {
  height: 2rpx;
  background: #e0e0e0;
  margin: 36rpx 0;
}

.block {
  margin-bottom: 44rpx;
}

.block-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #1e5aa8;
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}

.block-text {
  display: block;
  font-size: 28rpx;
  color: #444444;
  line-height: 52rpx;
}

.block-text.small {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999999;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  font-size: 24rpx;
  color: #1e5aa8;
  background: #eaf1fb;
  padding: 10rpx 22rpx;
  border-radius: 100rpx;
}

.tag-accent {
  color: #ffffff;
  background: #1e5aa8;
}

.btn {
  margin: 10rpx 0 40rpx 0;
  background: #1e5aa8;
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 100rpx;
  letter-spacing: 2rpx;
}

.btn::after {
  border: none;
}

.genshin-box {
  margin-top: 10rpx;
  animation: fadeIn 0.4s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.id-shot {
  width: 100%;
  margin-top: 8rpx;
  border-radius: 12rpx;
}

.footer {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #1e5aa8;
  font-weight: bold;
  letter-spacing: 2rpx;
}
