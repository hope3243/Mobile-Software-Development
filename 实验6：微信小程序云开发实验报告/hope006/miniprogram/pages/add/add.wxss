.upload-grid {
  display: grid;
  grid-template-columns: repeat(3, 218rpx);
  grid-auto-rows: 218rpx;
  column-gap: 14rpx;
  row-gap: 14rpx;
  justify-content: start;
  margin: 28rpx 0 18rpx
}

.upload-item {
  width: 218rpx;
  height: 218rpx;
  margin: 0;
  position: relative;
  border-radius: 20rpx;
  overflow: hidden
}

.upload-item image {
  width: 100%;
  height: 100%
}

.chooser {
  background: #eaf0e2;
  border: 2rpx dashed #c5d2b7;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: #6c805e;
  font-size: 24rpx;
  line-height: 1.4
}

.plus {
  font-size: 48rpx;
  line-height: 1;
  margin-bottom: 18rpx
}

.chooser-label {
  font-size: 24rpx;
  font-weight: 600
}

.upload-count {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  margin-top: 12rpx;
  color: #94a08d;
  font-size: 20rpx;
  line-height: 1;
  white-space: nowrap;
  word-break: keep-all
}

.draft-button {
  flex: 0 0 auto;
  padding: 14rpx 26rpx;
  border: 1rpx solid #d6dfcf;
  border-radius: 30rpx;
  background: #f0f3eb;
  color: #526754;
  font-size: 22rpx;
  line-height: 1.3
}

.disabled {
  opacity: .5
}

.remove {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 44rpx;
  height: 44rpx;
  background: #0008;
  color: white;
  border-radius: 50%;
  font-size: 32rpx;
  line-height: 40rpx
}

.cover-label {
  position: absolute;
  bottom: 10rpx;
  left: 10rpx;
  background: #fffD;
  font-size: 18rpx;
  padding: 5rpx 14rpx;
  border-radius: 18rpx
}

.progress {
  height: 10rpx;
  border-radius: 10rpx;
  background: #e1e8db;
  overflow: hidden
}

.progress view {
  height: 100%;
  background: #779a5a;
  transition: width .3s
}
