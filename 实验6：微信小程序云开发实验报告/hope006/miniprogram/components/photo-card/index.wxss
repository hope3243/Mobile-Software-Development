.card {
  background: #fff;
  border-radius: 22rpx;
  overflow: hidden;
  margin-bottom: 20rpx
}

.picture {
  position: relative;
  background: #dfe6d9
}

.picture image {
  width: 100%;
  height: 100%
}

.category {
  position: absolute;
  bottom: 18rpx;
  left: 16rpx;
  background: rgba(255, 255, 255, .9);
  border-radius: 30rpx;
  padding: 7rpx 16rpx;
  font-size: 19rpx;
  color: #425845
}

.count {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  color: white;
  background: #0005;
  padding: 5rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx
}

.body {
  padding: 22rpx 20rpx
}

.title {
  font-size: 26rpx;
  line-height: 1.6;
  font-weight: 600;
  color: #293e32
}

.meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx
}

.author {
  font-size: 20rpx;
  color: #8c9789;
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis
}

.dot {
  display: inline-block;
  width: 24rpx;
  height: 24rpx;
  background: #dce5d3;
  border-radius: 50%;
  margin-right: 9rpx
}

.favorite {
  color: #6a8569;
  width: 58rpx;
  min-height: 66rpx;
  margin: -13rpx -10rpx -13rpx 8rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column
}

.favorite.saved {
  color: #315f4f;
  background: #edf2e8
}

.heart {
  font-size: 31rpx;
  line-height: 30rpx
}

.like-count {
  color: #9aa399;
  font-size: 17rpx;
  line-height: 1;
  margin-top: 6rpx
}

.fallback {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  letter-spacing: 5rpx;
  color: #6e8667;
  background: linear-gradient(150deg, #e4e8d7, #b5c8b9)
}

.fallback text {
  font-size: 18rpx;
  letter-spacing: 0;
  margin-top: 20rpx
}

.mini-avatar {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  margin-right: 9rpx;
}
